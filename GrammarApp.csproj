<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GrammarApp</RootNamespace>
    <!-- Tests live in their own project under tests/; keep them out of the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>

    <!-- Portable: `dotnet publish -c Release -o publish` => GrammarApp.exe + model.gguf, runs anywhere, offline, no installs.
         llama.cpp's native DLLs must be real files in their runtimes\ layout, so the exe self-extracts everything
         (once, to %TEMP%\.net\GrammarApp) instead of loading from memory. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <ModelUrl>https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/main/Qwen3-4B-Instruct-2507-Q4_K_M.gguf</ModelUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GrammarApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- Vulkan = any GPU (NVIDIA/AMD/Intel) through the normal display driver; no CUDA install. Falls back to the CPU build. -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>

  <!-- The model is fetched once at build time (2.5 GB); the built app never touches the network. -->
  <Target Name="FetchModel" BeforeTargets="BeforeBuild" Condition="!Exists('models\model.gguf')">
    <DownloadFile SourceUrl="$(ModelUrl)" DestinationFolder="models" DestinationFileName="model.gguf" />
  </Target>

  <ItemGroup>
    <!-- ponytail: model stays next to the exe, not in it: bundling 2.5 GB would re-extract it to %TEMP% and hits the bundler's 2 GB limit -->
    <None Include="models\model.gguf" Link="model.gguf" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
